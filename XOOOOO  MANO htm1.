<!DOCTYPE html>
<html dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>لعبة XO - مانو</title>
<style>
body{background:#111;color:#fff;font-family:sans-serif;text-align:center;padding:20px}
h1{color:#facc15}
.board{display:grid;grid-template-columns:repeat(3,100px);gap:10px;justify-content:center;margin:30px auto}
.cell{width:100px;height:100px;background:#222;font-size:50px;display:flex;align-items:center;justify-content:center;border-radius:15px;cursor:pointer}
.cell:hover{background:#333}
button{padding:10px 30px;font-size:18px;background:#facc15;border:none;border-radius:10px;cursor:pointer;font-weight:bold}
</style>
</head>
<body>
<h1>لعبة XO بتاعة مانو 🎮</h1>
<div class="board" id="board"></div>
<button onclick="reset()">ابدأ من جديد</button>
<h2 id="status"></h2>
<script>
let board=["","","","","","","","",""]; let turn="X"; let over=false;
let b=document.getElementById("board"); let s=document.getElementById("status");
function draw(){ b.innerHTML=""; board.forEach((v,i)=>{ let d=document.createElement("div"); d.className="cell"; d.textContent=v; d.onclick=()=>play(i); b.appendChild(d); }); s.textContent=over?"":`الدور على: ${turn}`; }
function play(i){ if(board[i]!=""||over)return; board[i]=turn; check(); turn=turn=="X"?"O":"X"; draw(); }
function check(){ let w=[[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]]; w.forEach(a=>{ if(board[a[0]]&&board[a[0]]==board[a[1]]&&board[a[0]]==board[a[2]]){ s.textContent=`الفائز هو: ${board[a[0]]} 🎉`; over=true; } }); if(!board.includes("")&&!over){ s.textContent="تعادل! 😅"; over=true; } }
function reset(){ board=["","","","","","","","",""]; turn="X"; over=false; draw(); }
draw();
</script>
</body>
</html>
